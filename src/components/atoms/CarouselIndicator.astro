---
interface Props {
  index: number;
  isActive?: boolean;
}

const { index, isActive = false } = Astro.props;
---

<button
  type="button"
  class={`h-2.5 w-2.5 rounded-full transition-all ${isActive ? 'bg-farmstay-accent w-6' : 'bg-farmstay-bg/50 hover:bg-farmstay-bg'}`}
  data-slide-to={index}
  aria-label={`Przejdź do slajdu ${index + 1}`}></button>
