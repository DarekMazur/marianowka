---
interface Props {
	tag?: "input" | "textarea";
	label: string;
	name: string;
	placeholder?: string;
}

const {tag = "input", name, label, placeholder = label} = Astro.props

const Element = tag
---

<div>
  <label for={name} class="block text-xs uppercase tracking-wider text-gray-400 mb-1">{label}</label>
  <Element type="text" id={name} name={name} required class="w-full bg-white/10 border border-white/20 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-[#D4A373]" placeholder={placeholder} />
</div>