---
interface Props {
	tag?: "input" | "textarea" | "checkbox";
	label: string;
	name: string;
	placeholder?: string;
  type?: "text" | "checkbox" | "email";
  id?: string;
}

const {tag = "input", name, label, placeholder = label, type= "text", id = name} = Astro.props

const Element = tag
---

<div>
  <label for={`form_${id}`} class="block text-xs uppercase tracking-wider text-gray-400 mb-1">{label}</label>
  <Element type={type} id={`form_${id}`} name={name} required style={type !== "checkbox" ? "width: 100%" : ""} class="bg-white/10 border border-white/20 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-[#D4A373]" placeholder={placeholder} />
</div>