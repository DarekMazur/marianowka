---
import FormButton from '../atoms/FormButton.astro';
import FormInput from '../atoms/FormInput.astro';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: 'pl' | 'en' | 'ru';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const randomBotFieldName = `${Math.random().toString(36).substring(2, 8)}_${Date.now().toString()}`;

console.log(lang);
---

<div class="bg-white/5 p-8 rounded-2xl border border-white/10">
  <form
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot={randomBotFieldName}
    class="space-y-4"
    id="contact-form"
  >
    <p class="absolute -left-[9999vw]">
      <label>Lorem ipsum dolor sit amet<input name={randomBotFieldName} /></label>
    </p>
    <FormInput name="name" label={t('form.name')} placeholder={t('form.namePlaceholder')} />
    <FormInput
      label={t('form.email')}
      name="email"
      type="email"
      placeholder={t('form.emailPlaceholder')}
    />
    <FormInput
      name="message"
      label={t('form.message')}
      placeholder={t('form.messagePlaceholder')}
      tag="textarea"
    />

    <div id="consent-wrapper">
      <FormInput label={t('form.consent')} name="consent" type="checkbox" id="consent-checkbox" />
    </div>

    <div id="submit-wrapper">
      <FormButton buttonMessage={t('form.submit')} id="submit-btn" disabled />
    </div>
  </form>
</div>

<script>
  import { initContactForm } from '../../lib/contact-form.ts';
  initContactForm();
</script>
