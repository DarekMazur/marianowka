<div class="bg-white/5 p-8 rounded-2xl border border-white/10">
  <form name="contact" method="POST" data-netlify="true" class="space-y-4">
    <div>
      <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Twoje Imię</label>
      <input type="text" name="name" required class="w-full bg-white/10 border border-white/20 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-[#D4A373]" placeholder="Jan Kowalski">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Twój Adres E-mail</label>
      <input type="email" name="email" required class="w-full bg-white/10 border border-white/20 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-[#D4A373]" placeholder="jan@example.com">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Wiadomość</label>
      <textarea name="message" rows="3" required class="w-full bg-white/10 border border-white/20 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-[#D4A373]" placeholder="Dzień dobry, interesuje mnie termin..."></textarea>
    </div>
    <button type="submit" class="w-full bg-farmstay-green text-white font-medium py-3 rounded-lg hover:bg-opacity-90 transition-all cursor-pointer">
      Wyślij zapytanie
    </button>
  </form>
</div>