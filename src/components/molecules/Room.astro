---
interface Props {
	tag: string;
	title: string;
	desc: string;
	price: number;
	image: string;
}

const {tag, title, desc, price, image} = Astro.props
---

<div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
  <div class="h-64 bg-cover bg-center" style={`background-image: url('${image}')`}></div>
  <div class="p-6">
    <span class="text-xs font-semibold text-farmstay-green uppercase tracking-wider">{tag}</span>
    <h3 class="font-serif text-xl font-bold mt-1 mb-2">{title}</h3>
    <p class="text-sm text-gray-600 mb-4 font-light">{desc}</p>
    <div class="flex justify-between items-center pt-4 border-t border-gray-100">
      <span class="font-semibold text-farmstay-dark">od {price} zł / doba</span>
      <a href="#contact" class="text-sm font-medium text-farmstay-green hover:underline">Sprawdź &rarr;</a>
    </div>
  </div>
</div>