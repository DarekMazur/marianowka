---
import NavListItem from '../atoms/NavListItem.astro';
import { navData } from '../../mocks/navigation.ts';

const { lang = 'pl' } = Astro.props;

const currentNav = navData[lang] || navData.pl;
---

<nav class="hidden md:flex items-center gap-8 text-sm font-medium">
  {currentNav.map((item) => <NavListItem href={item.href} title={item.title} />)}
</nav>
