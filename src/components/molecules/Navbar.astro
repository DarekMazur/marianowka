---
import NavListItem from '../atoms/NavListItem.astro';
import LanguagePicker from '../atoms/LanguagePicker.astro';
import LinkedButton from '../atoms/LinkedButton.astro';
import { navData } from '../../mocks/navigation.ts';
import { useTranslations } from '../../i18n/utils.ts';

interface Props {
  lang?: 'pl' | 'en' | 'ru';
}

const { lang = 'pl' } = Astro.props;
const currentNav = navData[lang] || navData.pl;
const t = useTranslations(lang);
---

<nav class="hidden md:flex items-center gap-8 text-sm font-medium">
  {currentNav.map((item) => <NavListItem href={item.href} title={item.title} />)}
</nav>

<button
  id="menu-toggle"
  aria-label="Open Menu"
  class="md:hidden p-2 text-farmstay-dark focus:outline-none"
>
  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path
      id="menu-icon"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
</button>

<div
  id="mobile-menu"
  class="fixed inset-x-0 top-20 bg-farmstay-bg/95 backdrop-blur-xl border-b border-farmstay-dark/10 shadow-lg transform -translate-y-full opacity-0 pointer-events-none transition-all duration-300 ease-in-out md:hidden flex flex-col p-6 gap-6 z-40"
>
  <nav class="flex flex-col gap-4 text-base font-medium">
    {currentNav.map((item) => <NavListItem href={item.href} title={item.title} />)}
  </nav>

  <hr class="border-farmstay-dark/10" />

  <div class="flex items-center justify-between">
    <span class="text-sm text-farmstay-dark/60 font-medium">{t('nav.language')}:</span>
    <LanguagePicker lang={lang} />
  </div>

  <LinkedButton
    href="#contact"
    title={t('nav.bookNow')}
    size="text-sm"
    class="text-center w-full justify-center"
  />
</div>

<script>
  import { navbarView } from '../../lib/navbar.ts';

  navbarView();
</script>
