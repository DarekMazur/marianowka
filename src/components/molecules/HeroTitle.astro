---
interface Props {
	title: string;
	slogan?: string;
	subSlogan?: string;
}

const {title, slogan, subSlogan} = Astro.props;
---

<span class="inline-block uppercase tracking-widest text-xs font-semibold bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full mb-4">
	{title}
</span>
<h1 class="font-serif text-4xl md:text-6xl font-bold tracking-tight mb-6">
	{slogan}
</h1>
<p class="text-lg md:text-xl text-gray-200 mb-8 font-light">
	{subSlogan}
</p>