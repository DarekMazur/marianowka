---
import {Image} from "astro:assets";
import logo from '../assets/mut_logo.png'
---

<header class="fixed top-0 left-0 right-0 z-50 bg-farmstay-bg/90 backdrop-blur-md border-b border-farmstay-dark/10">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <Image
        src={logo}
        alt="Logo"
        width={100}
        height={100}
        class="w-15 h-15 object-contain transition-transform group-hover:scale-105"
      />
      <span class="font-serif text-2xl font-bold tracking-tight text-farmstay-dark">Lorem Ipsum</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
      <a href="#about" class="hover:text-farmstay-green transition-colors">O nas</a>
      <a href="#rooms" class="hover:text-farmstay-green transition-colors">Pokoje</a>
      <a href="#features" class="hover:text-farmstay-green transition-colors">Atrakcje</a>
      <a href="#contact" class="hover:text-farmstay-green transition-colors">Kontakt</a>
    </nav>

    <a href="#contact" class="bg-farmstay-green text-white px-5 py-2.5 rounded-full text-sm font-medium hover:bg-opacity-95 transition-all shadow-sm">Zarezerwuj</a>
  </div>
</header>