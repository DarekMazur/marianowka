---
import { getFullYear } from '../../lib/getFullYear.ts';
import { pageIdentityData } from '../../mocks/pageIdentity.ts';

const { lang = 'pl' } = Astro.props;
const currentIdentity = pageIdentityData[lang] || pageIdentityData.pl;
---

<footer class="bg-farmstay-dark text-white pb-12 px-6">
  <div
    class="max-w-7xl mx-auto pt-8 border-t border-white/10 text-center text-xs text-gray-400 font-light flex flex-col sm:flex-row justify-between items-center gap-4"
  >
    <p>&copy; {getFullYear()} {currentIdentity.pageName}</p>
    <p>Created by <a class="font-bold hover:cursor-pointer">Author</a></p>
  </div>
</footer>
