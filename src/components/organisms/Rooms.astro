---
const rooms = [
	{
		tag: "Domek Leśny",
		title: "Chata pod Świerkiem",
		desc: "Przestronny domek z kominkiem i tarasem widokowym na las.",
		price: "350 zł",
		image: "https://picsum.photos/seed/room1/600/400"
	},
	{
		tag: "Pokój 2-osobowy",
		title: "Pokój nad Jeziorem",
		desc: "Przytulne wnętrze z widokiem na wschód słońca nad taflą wody.",
		price: "220 zł",
		image: "https://picsum.photos/seed/room2/600/400"
	},
	{
		tag: "Apartament Rodzinny",
		title: "Bocianie Gniazdo",
		desc: "Idealny wybór dla rodziny z dziećmi, dwie sypialnie i aneks.",
		price: "420 zł",
		image: "https://picsum.photos/seed/room3/600/400"
	}
];
---

<section id="pokoje" class="py-20 px-6 max-w-7xl mx-auto">
  <div class="text-center mb-12">
    <h2 class="font-serif text-3xl font-bold mb-2">Nasze Pokoje i Domki</h2>
    <p class="text-gray-600 font-light">Wybierz przestrzeń idealną dla siebie i swojej rodziny</p>
  </div>

  <div class="grid md:grid-cols-3 gap-8">
		{rooms.map(room => (
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <div class="h-64 bg-cover bg-center" style={`background-image: url('${room.image}')`}></div>
          <div class="p-6">
            <span class="text-xs font-semibold text-farmstay-green uppercase tracking-wider">{room.tag}</span>
            <h3 class="font-serif text-xl font-bold mt-1 mb-2">{room.title}</h3>
            <p class="text-sm text-gray-600 mb-4 font-light">{room.desc}</p>
            <div class="flex justify-between items-center pt-4 border-t border-gray-100">
              <span class="font-semibold text-farmstay-dark">od {room.price} / doba</span>
              <a href="#contact" class="text-sm font-medium text-farmstay-green hover:underline">Sprawdź &rarr;</a>
            </div>
          </div>
        </div>
		))}
  </div>
</section>