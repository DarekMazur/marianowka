---
import CarouselButton from '../atoms/CarouselButton.astro';
import CarouselIndicator from '../atoms/CarouselIndicator.astro';
interface Slide {
  image: string;
  alt: string;
  caption?: string;
}

interface Props {
  slides?: Slide[];
  autoplayInterval?: number;
  class?: string;
}

const {
  slides = [
    {
      image: 'https://picsum.photos/id/10/1200/600',
      alt: 'Poranny widok na otaczającą przyrodę',
      caption: 'Sielskie poranki w otoczeniu natury',
    },
    {
      image: 'https://picsum.photos/id/14/1200/600',
      alt: 'Strefa wypoczynku na świeżym powietrzu',
      caption: 'Przestrzeń do relaksu i wyciszenia',
    },
    {
      image: 'https://picsum.photos/id/29/1200/600',
      alt: 'Lokalne otoczenie i ścieżki spacerowe',
      caption: 'Malownicze tereny spacerowe',
    },
  ],
  autoplayInterval = 5000,
  class: className = '',
} = Astro.props;
---

<div
  class={`relative w-full overflow-hidden bg-farmstay-dark shadow-lg group ${className}`}
  data-carousel
  data-interval={autoplayInterval}
>
  <div class="relative h-72 sm:h-96 md:h-[450px] w-full overflow-hidden">
    {
      slides.map((slide, index) => (
        <div
          class={`absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
          data-slide
        >
          <img
            src={slide.image}
            alt={slide.alt}
            class="h-full w-full object-cover"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
          {slide.caption && (
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-farmstay-dark/80 via-farmstay-dark/40 to-transparent p-6 text-farmstay-bg">
              <p class="text-lg font-medium drop-shadow-sm">{slide.caption}</p>
            </div>
          )}
        </div>
      ))
    }
  </div>

  <CarouselButton direction="prev" />
  <CarouselButton direction="next" />

  <div
    class="absolute bottom-4 right-4 z-20 flex items-center gap-3 rounded-full bg-farmstay-dark/60 px-4 py-2 backdrop-blur-sm"
  >
    <div class="flex items-center gap-1.5" data-carousel-indicators>
      {slides.map((_, index) => <CarouselIndicator index={index} isActive={index === 0} />)}
    </div>

    <div class="h-4 w-px bg-farmstay-bg/20"></div>

    <button
      type="button"
      class="flex h-7 w-7 items-center justify-center text-farmstay-bg transition-colors hover:text-farmstay-accent focus:outline-none"
      data-carousel-toggle
      aria-label="Wstrzymaj lub uruchom karuzelę"
    >
      <svg class="h-4 w-4 pause-icon" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
      </svg>
      <svg class="h-4 w-4 play-icon hidden" fill="currentColor" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  import { carousel } from '../../lib/carousel.ts';

  carousel();
</script>
