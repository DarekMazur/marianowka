---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/organisms/Hero.astro';
import Rooms from '../../components/organisms/Rooms.astro';
import Footer from '../../components/organisms/Footer.astro';
import Features from '../../components/organisms/Features.astro';
import Header from '../../components/organisms/Header.astro';
import Contact from '../../components/organisms/Contact.astro';
import ImageCarousel from '../../components/organisms/ImageCarousel.astro';

import { homeSlides } from '../../mocks/homeSlides.ts';

export async function getStaticPaths() {
  return [{ params: { lang: 'pl' } }, { params: { lang: 'en' } }, { params: { lang: 'ru' } }];
}

const { lang } = Astro.params;
const currentLang = (lang || 'pl').substring(0, 2);
const currentImages = homeSlides[lang] || homeSlides.pl;
---

<Layout>
  <Header lang={currentLang} />
  <Hero lang={currentLang} />
  <ImageCarousel slides={currentImages} autoplayInterval={4000} lang={currentLang} />
  <Rooms lang={currentLang} />
  <Features lang={currentLang} />
  <Contact lang={currentLang} />
  <Footer lang={currentLang} />
</Layout>
